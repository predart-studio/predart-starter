# Sanity CMS — copy to .env.local and fill in (or run `pnpm setup-sanity`).
# Find these in https://www.sanity.io/manage → your project → API.

# Client-safe (exposed to the browser):
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: pin the API version (defaults to a recent date if unset).
# NEXT_PUBLIC_SANITY_API_VERSION=2026-06-01

# Server-only secret (NEVER prefix with NEXT_PUBLIC). Needed for Draft Mode /
# Presentation preview. Create one at: project → API → Tokens (Viewer role).
SANITY_API_READ_TOKEN=
